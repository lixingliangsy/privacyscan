# Copy this file to .env.local and fill in to enable REAL AI generation.
# The app calls any OpenAI-compatible /chat/completions endpoint.
# Default is REAL mode; if no key is set (or the call fails) it falls back to demo output.

# Example: NVIDIA NIM (OpenAI-compatible)
OPENAI_API_KEY=nvapi-...
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=meta/llama-3.1-8b-instruct

# Or OpenAI / OpenRouter / Azure — just change the three values above.
